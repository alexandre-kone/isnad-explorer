{% extends 'base.html.twig' %}

{% block title %}Curation — Isnad Explorer{% endblock %}

{% block body %}
	<main class="page">
		<div class="page-head">
			<h2>Espace de curation</h2>
			<p>Connecté en tant que {{ app.user.displayName }}.</p>
		</div>

		<div class="cards">
			<div class="card">
				<div class="band">
					<span class="ref">Corpus</span>
				</div>
				<div class="cbody">
					<div class="field">
						<div class="fl">Transmetteurs</div>
						<div class="fv">{{ personCount }}</div>
					</div>
					<div class="field">
						<div class="fl">Hadiths</div>
						<div class="fv">{{ hadithCount }}</div>
					</div>
					<div class="field">
						<div class="fl">Recueils</div>
						<div class="fv">{{ collectionCount }}</div>
					</div>
				</div>
			</div>
		</div>

		<p style="margin-top: 20px;">
			<a class="gold-link" href="{{ path('admin_person_index') }}">Transmetteurs →</a>
			<a class="gold-link" style="margin-left: 18px;" href="{{ path('admin_collection_index') }}">Recueils →</a>
		</p>

		<p style="margin-top: 20px;">
			<a class="gold-link" href="{{ path('admin_logout') }}">Se déconnecter</a>
		</p>
	</main>
{% endblock %}
