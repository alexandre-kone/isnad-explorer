{% extends 'base.html.twig' %}

{% block title %}Recherche de hadith — Isnad Explorer{% endblock %}

{% block body %}
	<main class="page">
		<div class="page-head">
			<h2>Recherche de hadith</h2>
			<p>Recherchez par le texte (matn) ; chaque résultat affiche son isnad complet.</p>
		</div>

		{% if query is empty %}
			<div class="empty">
				<span class="ar">مدار</span>
				Saisissez un terme dans le champ de recherche pour lancer la recherche.
			</div>
		{% elseif results is empty %}
			<div class="empty" data-testid="no-results">
				<span class="ar">لا شيء</span>
				Aucun hadith ne correspond à « <strong>{{ query }}</strong> ».
			</div>
		{% else %}
			<p class="count" data-testid="result-count">
				{{ results|length }} résultat{{ results|length > 1 ? 's' }} pour « <strong>{{ query }}</strong> ».
			</p>

			<ul class="cards">
				{% for riwaya in results %}
					{% set spine = riwaya.spine %}
					<li class="card">
						<div class="band">
							<span class="ref">{{ riwaya.reference }}</span>
							{% if riwaya.grade %}<span class="pb">{{ riwaya.grade }}</span>{% endif %}
						</div>
						<div class="cbody">
							<blockquote>{{ riwaya.textFr }}</blockquote>
							{% if riwaya.textAr %}<p class="ar matn-ar">{{ riwaya.textAr }}</p>{% endif %}

							{% if spine %}
								<div class="field">
									{# Segment gharîb : la chaîne avant qu'elle ne s'évente au pivot. #}
									<div class="fl">Chaîne unique (gharîb)</div>
									<ol class="isnad">
										{% for person in spine %}
											<li>
												<span class="chip {{ loop.first ? 'first' }}{{ riwaya.pivot and person.slug == riwaya.pivot.slug ? 'pivot' }}">{{ person.displayName }}</span>
												{% if not loop.last %}<span class="arrow" aria-hidden="true">→</span>{% endif %}
											</li>
										{% endfor %}
									</ol>
								</div>
							{% endif %}

							{% if riwaya.cluster.turuq %}
								<p class="hint" style="margin-top: 10px;">
									Puis l'isnad s'évente : {{ riwaya.cluster.turuq }} — {{ riwaya.participants|length }} transmetteurs au total.
								</p>
							{% endif %}
						</div>
					</li>
				{% endfor %}
			</ul>
		{% endif %}
	</main>
{% endblock %}
